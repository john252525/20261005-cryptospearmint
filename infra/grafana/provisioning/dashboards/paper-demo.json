{
  "uid": "paper-demo",
  "title": "Paper Demo",
  "tags": ["trading", "paper-demo"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "NAV (USDT)",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "demo_nav_usd", "legendFormat": "nav", "refId": "A"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "Cash (USDT)",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "demo_cash_usd", "legendFormat": "cash", "refId": "A"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Position notional (USDT)",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "targets": [{"expr": "demo_position_notional_usd", "legendFormat": "{{symbol}}", "refId": "A"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Position qty",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 6},
      "targets": [{"expr": "demo_position_qty", "legendFormat": "{{symbol}}", "refId": "A"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Orders by status (cumulative)",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 12},
      "targets": [{"expr": "demo_orders_total", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "id": 6, "type": "timeseries", "title": "Fills (cumulative)",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 12},
      "targets": [{"expr": "demo_fills_total", "legendFormat": "fills", "refId": "A"}]
    },
    {
      "id": 7, "type": "timeseries", "title": "Fees (USDT, cumulative)",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 12},
      "targets": [{"expr": "demo_fees_total", "legendFormat": "fees", "refId": "A"}]
    },
    {
      "id": 8, "type": "timeseries", "title": "Orders rate (per second)",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 18},
      "targets": [{"expr": "sum(rate(demo_orders_total[1m]))", "legendFormat": "rate", "refId": "A"}]
    }
  ]
}
