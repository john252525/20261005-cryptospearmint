{
  "uid": "trading-desk",
  "title": "Trading Desk",
  "tags": ["trading"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "NAV (USDT)",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "risk_nav", "legendFormat": "nav", "refId": "A"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "Drawdown %",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "risk_drawdown_pct", "legendFormat": "dd%", "refId": "A"}]
    },
    {
      "id": 3, "type": "stat", "title": "Kill level",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 6},
      "targets": [{"expr": "risk_kill_level", "refId": "A", "instant": true}],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "orange", "value": 2},
              {"color": "red", "value": 3},
              {"color": "dark-red", "value": 4}
            ]
          },
          "min": 0, "max": 4, "unit": "none"
        }
      }
    },
    {
      "id": 4, "type": "timeseries", "title": "Orders per minute",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 6},
      "targets": [
        {"expr": "risk_orders_per_min", "legendFormat": "opm", "refId": "A"},
        {"expr": "sum(rate(risk_orders_total[1m])) * 60", "legendFormat": "rate", "refId": "B"}
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Order latency p50/p95/p99",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(risk_order_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(risk_order_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(risk_order_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Positions by symbol (USDT)",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "risk_position_size_usd", "legendFormat": "{{symbol}}", "refId": "A"}]
    },
    {
      "id": 7, "type": "timeseries", "title": "Funding accrued (USDT)",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 12},
      "targets": [{"expr": "risk_funding_accrued_usd", "legendFormat": "accrued", "refId": "A"}]
    },
    {
      "id": 8, "type": "timeseries", "title": "Delta exposure (bps)",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 12},
      "targets": [{"expr": "risk_delta_exposure_bps", "legendFormat": "delta_bps", "refId": "A"}]
    }
  ]
}
