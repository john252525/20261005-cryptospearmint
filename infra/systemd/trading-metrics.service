[Unit]
Description=Trading Metrics Exporter (:9100)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/trading-desk
Environment="PYTHONPATH=/root/trading-desk"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 -m src.monitoring.http_exporter --port 9100 --interval 5
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-metrics

[Install]
WantedBy=multi-user.target
