[Unit]
Description=Paper Demo Metrics Exporter (:9101)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/risk_v0
Environment="PYTHONPATH=/root/risk_v0"
Environment="DEMO_DB_PATH=/root/risk_v0/state/demo.db"
Environment="EXPORTER_PORT=9101"
ExecStart=/usr/bin/python3 demo_exporter.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
