[Unit]
Description=Paper Demo Runner (DCA BTC via PaperBroker)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/risk_v0
Environment="PYTHONPATH=/root/risk_v0"
Environment="DEMO_DURATION_SEC=3600"
Environment="DEMO_DB_PATH=/root/risk_v0/state/demo.db"
ExecStart=/usr/bin/python3 demo_runner.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
