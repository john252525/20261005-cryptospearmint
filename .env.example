# Copy to .env. Fill real testnet credentials. NEVER commit .env.

# --- project ---
APP_ENV=dev
LOG_LEVEL=INFO
TZ=UTC

# --- crypto exchanges ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- equities / futures vendors ---
POLYGON_API_KEY=
DATABENTO_API_KEY=

# --- broker: IBKR ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# --- alerts: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- alerts: SMTP ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- QA honesty guardrails ---
QA_VENUE=bybit                 # binance|bybit
QA_DB_PATH=data/state.db
QA_CCXT_TIMEOUT_MS=8000
